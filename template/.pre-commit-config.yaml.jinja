# Runs on every commit. CI runs the same hooks, because a hook can be skipped
# locally with --no-verify.
#
# Husky owns the git hook and runs lint-staged on frontend files.
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-toml
      - id: check-added-large-files
        args: [--maxkb=1024]
      - id: check-merge-conflict
      - id: detect-private-key

  - repo: local
    hooks:
      - id: adr-drift
        name: architecture decision records
        entry: node docs/architecture/decisions/verify.mjs
        language: system
        pass_filenames: false
        files: ^docs/architecture/decisions/.*\.md$

      - id: frontend-check
        name: frontend FSD layers, slices, public API
        entry: node docs/architecture/frontend.verify.mjs
        language: system
        pass_filenames: false
        files: ^src/.*\.(ts|tsx)$

      - id: frontend-lint
        name: eslint (staged frontend files)
        entry: bash -c "pnpm exec eslint --max-warnings=0 $(git diff --cached --name-only --diff-filter=ACM --relative -- '*.ts' '*.tsx')"
        language: system
        files: ^src/.*\.(ts|tsx)$
