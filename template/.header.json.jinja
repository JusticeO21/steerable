{
  "template": {
    "source": {{ _copier_conf.src_path | string | tojson }},
    "copier_version": {{ _copier_conf.version | string | tojson }},
    "generated_at": "2026-11-07"
  },
  "project_name": {{ project_name | tojson }},
  "project_type": "frontend-only",
  "answers": {
    "frontend_root": ".",
    "frontend_source_root": "src",
    "package_manager": {{ package_manager | tojson }},
    "openapi_schema": {{ openapi_schema | tojson }},
    "ui_stack": {{ ui_stack | tojson }}
  },
  "scope": "frontend-only",
  "tools": {
    "setup": {{ setup_command | tojson }},
    "dev": {{ dev_command | tojson }},
    "dev_server_probe": {{ dev_server_probe | tojson }},
    "check": {{ check_command | tojson }},
    "api_types": {{ api_client_command | tojson }},
    "fsd_lint": {{ fsd_lint_command | tojson }},
    "package_manager": {{ package_manager | tojson }},
    "frontend_commands": {
      "format": "{{ package_manager }} run format:check",
      "lint": "{{ package_manager }} run lint",
      "types": "{{ package_manager }} run typecheck",
      "tests": "{{ package_manager }} run test",
      "e2e": "{{ package_manager }} run test:e2e"
    },
    "acceptance": {{ dev_server_probe | tojson }}
  },
  "paths": {
    "frontend_root": ".",
    "frontend_source_root": "src",
    "frontend_toolchain": [
      "package.json",
      "eslint.config.mjs",
      "vite.config.ts",
      "vitest.config.ts",
      "tsconfig.base.json",
      "tsconfig.json",
      "tsconfig.e2e.json",
      "prettier.config.mjs",
      "playwright.config.ts",
      ".husky/pre-commit",
      ".github/workflows/verify.yml"
    ],
    "docs_root": "docs"
  },
  "agents": {
    "entrypoint": "AGENTS.md",
    "pointer_files": [
      "CLAUDE.md",
      "Gemini.md",
      ".github/copilot-instructions.md"
    ],
    "tiering_table": "docs/architecture/path-rules.md#which-rules-apply-to-this-path",
    "adr_dir": "docs/architecture/decisions",
    "adr_drift_check": "node docs/architecture/decisions/verify.mjs",
    "frontend_drift_check": "node docs/architecture/frontend.verify.mjs",
    "sources": {
      "scope": ["AGENTS.md", "docs/architecture/overview.md"],
      "frontend_rules": ["AGENTS.md", "docs/architecture/frontend.md"],
      "commands": ["AGENTS.md", "package.json"],
      "acceptance_check": [".header.json", "AGENTS.md"],
      "auth_decisions": "not-in-repo: owned by the API repository; link its ADR-001 URL in docs/architecture/decisions/README.md",
      "business_rules": ["AGENTS.md", "docs/product/business-rules.md"]
    }
  }
}
