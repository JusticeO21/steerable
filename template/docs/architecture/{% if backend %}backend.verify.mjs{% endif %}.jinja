// Enforces the layer and module rules in docs/architecture/backend.md.
// Structural only: no third-party packages, so it runs before dependencies are
// installed and cannot be skipped by a missing dev dependency.
//
//   node docs/architecture/backend.verify.mjs
//
// Exits 1 and prints every violation. A violation is a defect in the code, not
// in this script; fix the import, never the rule.

import { readdirSync, readFileSync, statSync } from 'node:fs'
import { dirname, join, relative, sep } from 'node:path'
import { fileURLToPath } from 'node:url'

const here = dirname(fileURLToPath(import.meta.url))
const repoRoot = join(here, '..', '..')
const backendRoot = '{{ backend_root }}'
const appRoot = join(repoRoot, backendRoot, 'app')

// Which layer may import which. Anything not listed is disallowed.
const ALLOWED = {
  router: ['service', 'schemas', 'core'],
  service: ['repository', 'schemas', 'core', 'events', 'tasks'],
  repository: ['schemas', 'core', 'events'],
  schemas: ['core'],
  events: ['schemas', 'core'],
  tasks: ['service', 'schemas', 'repository', 'core', 'events'],
  // A module's __init__ is a public surface; it may only re-export own layers.
  'module-init': ['router', 'service', 'schemas', 'repository', 'events', 'tasks', 'core'],
  core: [],
}

const errors = []

function walk(dir) {
  const out = []
  let entries
  try {
    entries = readdirSync(dir)
  } catch {
    return out
  }
  for (const name of entries) {
    if (name === '__pycache__' || name.startsWith('.')) continue
    const full = join(dir, name)
    if (statSync(full).isDirectory()) out.push(...walk(full))
    else if (name.endsWith('.py')) out.push(full)
  }
  return out
}

function classify(absPath) {
  const rel = relative(appRoot, absPath).split(sep)
  if (rel[0] === 'core') return { layer: 'core', module: null }
  if (rel[0] !== 'modules' || rel.length < 3) return { layer: null, module: null }
  const module = rel[1]
  const file = rel[rel.length - 1]
  const stem = file.replace(/\.py$/, '')
  if (stem === '__init__') return { layer: 'module-init', module, init: true }
  return ALLOWED[stem] ? { layer: stem, module } : { layer: null, module }
}

// Parses `from a.b import c` / `import a.b` into dotted module paths. Relative
// imports are ignored: they never leave the module.
function imports(file) {
  const source = readFileSync(file, 'utf8')
  const found = []
  const re = /^(?:from\s+([\w.]+)\s+import|import\s+([\w.]+))/gm
  let match
  while ((match = re.exec(source)) !== null) {
    const path = match[1] ?? match[2]
    if (!path.startsWith('.')) found.push(path)
  }
  return found
}

const files = walk(appRoot)
if (files.length === 0) {
  console.log(`boundary-check: no backend source under ${backendRoot}/app yet; nothing to verify`)
  process.exit(0)
}

for (const file of files) {
  const from = classify(file)
  const relFile = relative(repoRoot, file).split(sep).join('/')
  if (!from.layer) continue

  for (const imported of imports(file)) {
    const parts = imported.split('.')
    const appAt = parts.indexOf('app')
    if (appAt === -1) continue
    const target = parts.slice(appAt + 1)
    const layer = target[0]
    const module = layer === 'modules' ? target[1] : null

    if (layer === 'modules') {
      if (from.layer === 'core') {
        errors.push(`${relFile}: core must not import modules (found ${imported})`)
        continue
      }
      if (module && module !== from.module) {
        // The one legal cross-module edge: a service calling another module's
        // service. Everything else is a boundary breach.
        const sibling = target[2]?.replace(/\.py$/, '')
        if (from.layer === 'service' && sibling === 'service') continue
        errors.push(`${relFile}: layer "${from.layer}" of module "${from.module}" imports "${sibling ?? target.slice(1).join('.')}" from module "${module}"; only a service may call another module's service`)
        continue
      }
      // Same module: allowed only if the sibling layer is one this layer owns.
      const sibling = target[2]?.replace(/\.py$/, '')
      if (sibling && sibling !== from.layer) {
        const allowed = ALLOWED[from.layer] ?? []
        if (!allowed.includes(sibling)) {
          errors.push(`${relFile}: ${from.layer} must not import ${sibling} (found ${imported}); allowed: ${allowed.join(', ') || 'none'}`)
        }
      }
      continue
    }

    if (layer === 'core' || !layer) continue
    const allowed = ALLOWED[from.layer] ?? []
    if (!allowed.includes(layer)) {
      errors.push(`${relFile}: ${from.layer} must not import ${layer} (found ${imported}); allowed: ${allowed.join(', ') || 'none'}`)
    }
  }
}

if (errors.length) {
  console.error(`boundary-check: ${errors.length} violation(s)`)
  for (const line of errors) console.error(`  ${line}`)
  process.exit(1)
}

console.log(`boundary-check: ${files.length} file(s) follow the layer and module rules`)
