[project]
name = {{ project_name | lower | replace(' ', '-') | replace('_', '-') | tojson }}
version = "0.1.0"
description = {{ project_name | tojson }}
requires-python = ">={{ python_version }}"
dependencies = []

[dependency-groups]
dev = [
  "pytest>=8",
  "ruff>=0.16",
  "mypy>=1.13",
  "pre-commit>=4",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = [{{ backend_root|replace('/', '.') | replace('src.', '') | tojson }}]

# ---------------------------------------------------------------------------
# Ruff: linting and formatting. This config is the project default; changing a
# rule set is an ADR-worthy decision, not a per-file exception.
# ---------------------------------------------------------------------------
[tool.ruff]
target-version = "py{{ python_version | replace('.', '') }}"
line-length = 100

[tool.ruff.lint]
select = [
  "E",    # pycodestyle errors
  "W",    # pycodestyle warnings
  "F",    # pyflakes
  "I",    # isort
  "N",    # pep8-naming
  "UP",   # pyupgrade
  "B",    # bugbear
  "A",    # builtin shadowing
  "C4",   # comprehensions
  "DTZ",  # timezone-aware datetimes
  "T20",  # no print statements
  "SIM",  # simplify
  "PTH",  # use pathlib
  "RUF",  # ruff-specific
  "S",    # bandit security rules
  "ASYNC",# async correctness
  "ARG",  # unused arguments
  "RET",  # return consistency
  "PL",   # pylint subset
]
ignore = [
  "PLR0913", # too many arguments: keyword-only args are the fix, not a cap
  "PLR2004", # magic value comparison: common and readable in tests
]

[tool.ruff.lint.per-file-ignores]
"{{ backend_root }}/tests/**" = ["S101", "PLR2004"]   # asserts and literals are the point in tests
"{{ migrations_root }}/**" = ["E501"]                 # generated migration files
"tools/check.py" = ["T201", "S603"]                   # a command-line gate runner runs the tools and reports by printing

[tool.ruff.lint.isort]
known-first-party = [{{ backend_root|replace('/', '.') | replace('src.', '') | tojson }}]

[tool.ruff.format]
quote-style = "double"

# ---------------------------------------------------------------------------
# mypy: strict. Every function annotated, no implicit Any, no untyped defs.
# ---------------------------------------------------------------------------
[tool.mypy]
python_version = "{{ python_version }}"
# Imports resolve from the package root, the way the wheel installs them:
# `from backend.app.modules.orders.service import ...`, not `src.backend...`.
mypy_path = [{{ backend_root.split('/', 1)[0] | tojson }}]
explicit_package_bases = true
strict = true
warn_unreachable = true
warn_no_return = true
no_implicit_reexport = true
show_error_codes = true
pretty = true

[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false

# ---------------------------------------------------------------------------
# pytest
# ---------------------------------------------------------------------------
[tool.pytest.ini_options]
testpaths = ["{{ backend_root }}/tests"]
addopts = "-ra --strict-markers --strict-config"
filterwarnings = ["error"]
